{
	"schemaVersion": 1,
	"id": "loadonce",
	"version": "${version}",
	"name": "LoadOnce",
	"description": "Prototypes JVM initialization reuse and native resource reconstruction for Minecraft.",
	"authors": [
		"qb20nh"
	],
	"contact": {
		"homepage": "https://github.com/qb20nh/LoadOnce",
		"sources": "https://github.com/qb20nh/LoadOnce",
		"issues": "https://github.com/qb20nh/LoadOnce/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/loadonce/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.qb20nh.loadonce.LoadOnceMod"
		],
		"client": [
			"com.qb20nh.loadonce.client.LoadOnceClient"
		]
	},
	"mixins": [
		"loadonce.mixins.json",
		{
			"config": "loadonce.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
