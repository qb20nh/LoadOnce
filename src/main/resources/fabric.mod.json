{
	"schemaVersion": 1,
	"id": "loadonce",
	"version": "${version}",
	"name": "LoadOnce",
	"description": "Experimental Stage 1 startup-readiness probe for the LoadOnce JVM runtime. Minecraft initialization and client graphics are recreated normally; this adapter does not checkpoint Minecraft.",
	"authors": [
		"LoadOnce contributors"
	],
	"license": "CC0-1.0",
	"icon": "assets/loadonce/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.loadonce.fabric.LoadOnceMod"
		],
		"client": [
			"io.loadonce.fabric.client.LoadOnceClient"
		]
	},
	"mixins": [
		{
			"config": "loadonce.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
