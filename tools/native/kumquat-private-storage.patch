@@ -0,0 +1,148 @@
+// Copyright 2026 The LoadOnce Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use std::fs;
+use std::io;
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Component, Path, PathBuf};
+
+extern "C" {
+    fn geteuid() -> u32;
+}
+
+fn invalid(path: &Path, reason: &str) -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidInput,
+        format!(
+            "private storage {}: {}; choose an absolute path in an existing owned mode-0700 directory without symlinks",
+            path.display(), reason
+        ),
+    )
+}
+
+pub fn validate_directory(path: &Path) -> io::Result<()> {
+    if !path.is_absolute() {
+        return Err(invalid(path, "relative path"));
+    }
+    let mut current = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::RootDir | Component::Normal(_) => current.push(component.as_os_str()),
+            _ => return Err(invalid(path, "non-normal path component")),
+        }
+        let metadata = fs::symlink_metadata(&current)?;
+        if !metadata.is_dir() || metadata.file_type().is_symlink() {
+            return Err(invalid(path, "symlink or non-directory component"));
+        }
+    }
+    let metadata = fs::symlink_metadata(path)?;
+    // SAFETY: geteuid has no arguments and returns the calling process's effective UID.
+    let uid = unsafe { geteuid() };
+    if metadata.uid() != uid || metadata.mode() & 0o7777 != 0o700 {
+        return Err(invalid(
+            path,
+            "directory must be owned by the effective UID with mode 0700",
+        ));
+    }
+    Ok(())
+}
+
+pub fn validate_socket_path(path: &Path) -> io::Result<()> {
+    let bytes = path.as_os_str().as_bytes();
+    if !path.is_absolute() || bytes.len() > 107 || bytes.contains(&0) || bytes.ends_with(b"/") {
+        return Err(invalid(
+            path,
+            "invalid absolute Unix socket pathname (maximum 107 bytes)",
+        ));
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| invalid(path, "missing parent"))?;
+    validate_directory(parent)?;
+    if !matches!(path.components().next_back(), Some(Component::Normal(_))) {
+        return Err(invalid(path, "invalid socket basename"));
+    }
+    match fs::symlink_metadata(path) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error),
+        Ok(_) => Err(invalid(
+            path,
+            "socket pathname already exists; refusing to overwrite",
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{symlink, DirBuilderExt, PermissionsExt};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+    struct PrivateDir(PathBuf);
+    impl PrivateDir {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "kumquat-storage-test-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+            Self(path)
+        }
+    }
+    impl Drop for PrivateDir {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    #[test]
+    fn accepts_private_directory_and_absent_socket() {
+        let directory = PrivateDir::new();
+        validate_directory(&directory.0).unwrap();
+        validate_socket_path(&directory.0.join("gpu")).unwrap();
+    }
+
+    #[test]
+    fn rejects_relative_public_and_parent_paths() {
+        let directory = PrivateDir::new();
+        assert!(validate_directory(Path::new("relative")).is_err());
+        assert!(validate_directory(&directory.0.join("..")).is_err());
+        fs::set_permissions(&directory.0, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(validate_directory(&directory.0).is_err());
+        assert!(validate_socket_path(&directory.0.join("gpu")).is_err());
+    }
+
+    #[test]
+    fn rejects_symlink_directory_and_existing_socket_without_deleting() {
+        let directory = PrivateDir::new();
+        let alias = directory.0.join("alias");
+        symlink(&directory.0, &alias).unwrap();
+        assert!(validate_directory(&alias).is_err());
+        assert!(validate_socket_path(&alias.join("gpu")).is_err());
+        let file = directory.0.join("gpu");
+        fs::write(&file, b"retain").unwrap();
+        assert!(validate_socket_path(&file).is_err());
+        assert_eq!(fs::read(&file).unwrap(), b"retain");
+        let link = directory.0.join("gpu-link");
+        symlink(&file, &link).unwrap();
+        assert!(validate_socket_path(&link).is_err());
+        assert!(fs::symlink_metadata(&link)
+            .unwrap()
+            .file_type()
+            .is_symlink());
+    }
+
+    #[test]
+    fn rejects_oversized_socket_and_changed_directory() {
+        let directory = PrivateDir::new();
+        assert!(validate_socket_path(&directory.0.join("x".repeat(108))).is_err());
+        validate_directory(&directory.0).unwrap();
+        fs::set_permissions(&directory.0, fs::Permissions::from_mode(0o770)).unwrap();
+        assert!(validate_directory(&directory.0).is_err());
+    }
+}
